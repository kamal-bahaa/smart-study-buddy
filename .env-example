NODE_ENV=development

PORT=3000

# Local (non-Docker) dev connection. Under docker compose this is overridden
# automatically using the POSTGRES_* values below — no need to edit it.
DATABASE_URL="postgresql://postgres:admin@localhost:5432/smart_study_db?schema=public"

# Used by docker compose to provision the postgres container + derive DATABASE_URL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=smart_study_db

# Local default for the AI extract service; compose overrides to http://ai-service:8000/extract
AI_EXTRACT_URL=http://localhost:8000/extract


JWT_SECRET=jwt-secret-here


JWT_REFRESH_SECRET=refresh-token-here

JWT_EXPIRES_IN=3h
JWT_REFRESH_EXPIRES_IN=7d

BCRYPT_ROUNDS=12


GEMINI_API_KEY=gemini-api-key-here
GROQ_API_KEY=groq-api-key-here

INTERNAL_SECRET=internal-secret-here

